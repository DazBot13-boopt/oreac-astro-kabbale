{
  "name": "oreac-astro-kabbale",
  "version": "1.0.0",
  "private": true,
  "description": "Application hors ligne OREAC Astro Kabbale",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "node scripts/prepare-web.mjs",
    "build:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.oreac.astrokabbale",
    "productName": "OREAC Astro Kabbale",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "admin.html",
      "biorythme.html",
      "favicon.png",
      "classique/**/*",
      "js/**/*",
      "vendor/**/*",
      "fonts/**/*",
      "data/interpretations.json",
      "data/classique-horoscope.json",
      "data/classique-portrait.json",
      "legacy/README.md"
    ],
    "extraResources": [
      {
        "from": "legacy",
        "to": "legacy",
        "filter": ["**/*", "!**/*.exe", "!**/Horoscope/**", "!**/Astrologie/**"]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "OREAC-Astro-Kabbale-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
